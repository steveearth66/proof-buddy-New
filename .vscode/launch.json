{
    "version": "0.2.0",
    "compounds": [
      {
        "name": "Full Stack Debug",
        "configurations": ["Python: Django", "React: Debug Terminal"]
      }
    ],
    "configurations": [
      {
        "name": "Python: Django",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/django_server/manage.py",
        "args": ["runserver"],
        "django": true,
        "justMyCode": true,
        "preLaunchTask": "djangoSetup"
      },
      {
        "name": "React: Debug Terminal",
        "type": "node-terminal",
        "request": "launch",
        "command": "cd client; npm start",
        "serverReadyAction": {
          "pattern": "Local:",
          // "uriFormat": "%s",
          "action": "openExternally"
        }
      },
      {
        "name": "React: Chrome with Source Maps",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:3000",
        "webRoot": "${workspaceFolder}/client/src",
        "sourceMapPathOverrides": {
            "webpack:///src/*": "${webRoot}/*"
        }
      }
    ],
    "tasks": [
      {
        "label": "djangoSetup",
        "type": "shell",
        "command": "cd django_server; python manage.py migrate; python manage.py createcachetable",
        "problemMatcher": []
      }
    ]
  }